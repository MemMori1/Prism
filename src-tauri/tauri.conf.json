{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism",
  "version": "0.2.3",
  "identifier": "com.prism.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1520",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prism",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3QUQ2MjAwRTZERDZFNUMKUldSY2J0M21BR0t0WnhGakt0UG01UUVHZkl1dTU5UGdmZnNHYncvVlFtQW1FZitsU2IrenoxajYK",
      "endpoints": [
        "https://memmori1.github.io/Prism/latest.json",
        "https://github.com/MemMori1/Prism/releases/latest/download/latest.json"
      ]
    }
  }
}
